{{!-- {{#> callout tone="info"}}Text with <strong>markup</strong>{{/callout}}
      tone: info | success | warning | danger --}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:6px 0 18px">
  <tr><td style="padding:12px 14px;background:{{tone tone "bg"}};border:1px solid {{tone tone "border"}};border-radius:10px;font-size:14px;line-height:1.55;color:{{tone tone "fg"}}">{{> @partial-block}}</td></tr>
</table>
