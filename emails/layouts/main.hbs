<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="light">
<meta name="supported-color-schemes" content="light">
<title>{{title}}</title>
</head>
<body style="margin:0;padding:0;background:{{theme.soft}};-webkit-text-size-adjust:100%">
{{!-- Preview text shown after the subject in the inbox list. --}}
<div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent">{{preheader}}&#8203;&nbsp;&#8203;&nbsp;&#8203;&nbsp;&#8203;&nbsp;</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:{{theme.soft}}">
  <tr><td align="center" style="padding:28px 12px">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:560px;font-family:{{theme.font}}">
      <tr><td style="background:#ffffff;border:1px solid {{theme.border}};border-radius:16px;overflow:hidden">
        {{!-- Header: the site's dark theme with the white logo. --}}
        <div style="background:{{theme.night}};padding:20px 28px">
          <a href="{{site.url}}" style="text-decoration:none;color:#ffffff;font-size:20px;font-weight:700">
            <img src="{{site.logo}}" alt="{{site.name}}" height="30" style="display:block;height:30px;width:auto;border:0;color:#ffffff">
          </a>
        </div>
        {{!-- Logo gradient (blue -> violet). --}}
        <div style="height:4px;background:{{theme.primary}};background-image:linear-gradient(90deg,{{theme.from}},{{theme.to}})"></div>
        <div style="padding:28px 28px 14px;color:{{theme.ink}}">
          {{{body}}}
        </div>
      </td></tr>
      <tr><td style="padding:18px 8px 0;font-size:12px;line-height:1.6;color:{{theme.faint}};text-align:center">
        {{#if isAdmin}}
          Internal alert from your {{site.name}} admin panel.
          Change alert settings in <a href="{{site.url}}/admin/settings" style="color:{{theme.primary}}">Admin &gt; Settings</a>.
        {{else}}
          {{#if business.email}}
            Questions? Reply to this email or write to <a href="mailto:{{business.email}}" style="color:{{theme.primary}}">{{business.email}}</a>.
          {{else}}
            Questions? Just reply to this email.
          {{/if}}
          <br>{{business.legalName}}{{#if business.address}} &middot; {{business.address}}{{/if}}
          <br><a href="{{site.url}}" style="color:{{theme.primary}}">{{site.host}}</a>
        {{/if}}
      </td></tr>
    </table>
  </td></tr>
</table>
</body>
</html>
