{{!-- Alerts to the store owner. Data: label, tone, subject, paragraphs[{text}] (plain text, URLs auto-linked), actionUrl --}}
<div style="display:inline-block;margin:0 0 12px;padding:3px 10px;border-radius:999px;background:{{tone tone "bg"}};color:{{tone tone "fg"}};font-size:12px;font-weight:700;letter-spacing:0.3px;text-transform:uppercase">{{label}}</div>
{{> heading text=subject}}

{{#each paragraphs}}
  {{#> para theme=../theme}}{{linkify text}}{{/para}}
{{/each}}

{{#if actionUrl}}
  {{> button url=actionUrl label="Open in admin"}}
{{/if}}
