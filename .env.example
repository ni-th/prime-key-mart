# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Postgres connection string. Matches docker-compose.yml for local dev
# (host port 5433 to avoid clashing with a locally-installed Postgres on 5432).
DATABASE_URL="postgresql://keymart:keymart@localhost:5433/keymart?schema=public"

# Base URL of the site (no trailing slash). Used on the server for Stripe
# redirect URLs, email links, and metadata.
SITE_URL="http://localhost:3000"

# Auth.js session secret. Generate one with:  openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-random-32-byte-base64-string"

# AES-256-GCM key used to encrypt license keys at rest. MUST be 32 bytes, base64.
# Generate one with:  openssl rand -base64 32
KEY_ENCRYPTION_SECRET="replace-me-with-a-random-32-byte-base64-string"

# --- Stripe (test mode) -----------------------------------------------------
# OPTIONAL. Leave as-is (or blank) and checkout uses a local simulated payment
# page — no card, no external account. Paste a real test key to switch to Stripe
# Checkout; nothing else changes.
#   Dashboard > Developers > API keys
STRIPE_SECRET_KEY="sk_test_xxx"
#   From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# --- Email (SMTP via Nodemailer) -----------------------------------------------
# Leave SMTP_HOST empty to fall back to an auto-created Ethereal test inbox in dev
# (a preview URL is logged to the server console for every sent message).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="KeyMart <no-reply@keymart.test>"
