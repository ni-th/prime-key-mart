# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Postgres connection string. Matches docker-compose.yml for local dev
# (host port 5433 to avoid clashing with a locally-installed Postgres on 5432).
DATABASE_URL="postgresql://keymart:keymart@localhost:5433/keymart?schema=public"

# Base URL of the site (no trailing slash). Used on the server for Stripe
# redirect URLs, email links, and metadata.
SITE_URL="http://localhost:3000"

# Auth.js session secret. Generate one with:  openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-random-32-byte-base64-string"

# AES-256-GCM key used to encrypt license keys at rest. MUST be 32 bytes, base64.
# Generate one with:  openssl rand -base64 32
KEY_ENCRYPTION_SECRET="replace-me-with-a-random-32-byte-base64-string"

# --- PayHere (sandbox) ------------------------------------------------------
# OPTIONAL. Leave blank and checkout uses the local simulated payment page.
PAYHERE_MERCHANT_ID="xxx"
PAYHERE_MERCHANT_SECRET="xxx"
PAYHERE_MODE="sandbox"
# Temporary display/payment conversion rate for local currency checkout.
PAYHERE_USD_TO_LKR_RATE="300"
STRIPE_SECRET_KEY="sk_test_xxx"
#   From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# --- Email (SMTP via Nodemailer) -----------------------------------------------
# Leave SMTP_HOST empty to fall back to an auto-created Ethereal test inbox in dev
# (a preview URL is logged to the server console for every sent message).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Keysby <no-reply@keysby.com>"
# Where "action needed" alerts go (e.g. an order paid but out of stock).
# Falls back to SMTP_USER when empty.
ADMIN_EMAIL=""

# --- Business details (Contact page, policies, footer) ------------------------
# PayHere requires a contact email, phone and business address on a live store.
# Anything left empty is hidden. SUPPORT_EMAIL falls back to ADMIN_EMAIL.
BUSINESS_NAME="Keysby"
SUPPORT_EMAIL=""
SUPPORT_PHONE=""
BUSINESS_ADDRESS=""
BUSINESS_REG_NO=""
BUSINESS_COUNTRY="Sri Lanka"

# --- Seeding (local development only) -----------------------------------------
# `npm run db:seed` creates FAKE keys and a test customer, and refuses to run
# against a non-local database. The admin is created only if it doesn't exist.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
