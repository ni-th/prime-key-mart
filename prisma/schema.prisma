// Keysby data model. See prisma/seed.ts for sample data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum KeyStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  FAILED
  EXPIRED
  REFUNDED
}

model User {
  id             String               @id @default(cuid())
  email          String               @unique
  name           String?
  passwordHash   String?
  role           Role                 @default(USER)
  suspended      Boolean              @default(false)
  suspendedAt    DateTime?
  suspensionNote String?
  // Two-factor auth (authenticator app). Required for ADMIN users.
  // totpSecret is a JSON-encoded EncryptedSecret (AES-256-GCM, see lib/crypto.ts).
  totpSecret     String?
  totpEnabled    Boolean              @default(false)
  totpLastStep   Int? // last accepted 30s time-step; blocks code replay
  orders         Order[]
  passwordResets PasswordResetToken[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

/// One-time "forgot password" link. Only a SHA-256 of the token is stored, so a
/// database leak can't be turned into working reset links.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

/// Store-wide settings editable in the admin panel. A single row, id "default".
model StoreSettings {
  id                String @id @default("default")
  /// LKR per 1 USD (market rate). Null = fall back to PAYHERE_USD_TO_LKR_RATE.
  usdToLkrRate      Float?
  /// Added on top of the market rate for calculated LKR prices (e.g. 2.5 = +2.5%).
  lkrMarginPercent  Float  @default(0)
  /// Payment gateway (PayHere) fee as a percent of each payment, for profit reports.
  gatewayFeePercent Float  @default(0)

  // --- Admin alerts (emails to the store owner) ---
  /// Comma-separated recipients. Empty = ADMIN_EMAIL from the environment.
  alertEmails         String?
  /// Default "low stock" level: alert when available keys fall below this.
  lowStockThreshold   Int      @default(5)
  alertLowStock       Boolean  @default(true)
  alertOutOfStock     Boolean  @default(true)
  alertFailedDelivery Boolean  @default(true)
  alertPaymentProblem Boolean  @default(true)
  alertNewOrder       Boolean  @default(false)
  updatedAt           DateTime @updatedAt
  updatedBy           String?
}

/// An old category slug that permanently redirects to the category's current
/// page, so shared links and search results keep working after a rename.
model CategorySlugRedirect {
  slug       String   @id
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([categoryId])
}

enum DiscountScope {
  ALL
  CATEGORIES
  PRODUCTS
}

/// A sale: percent off a set of products, optionally between two dates. When
/// several sales cover a product, the biggest one wins (they never stack).
model Discount {
  id         String        @id @default(cuid())
  name       String
  /// Percent off, e.g. 20 = 20% off. Applies to USD and LKR alike.
  percent    Float
  scope      DiscountScope @default(ALL)
  categories Category[]
  products   Product[]
  active     Boolean       @default(true)
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([active])
}

/// Every admin alert we tried to send (shown in Admin -> Settings).
model AlertLog {
  id         String   @id @default(cuid())
  type       String
  subject    String
  body       String
  recipients String
  /// SENT, FAILED (email error) or SUPPRESSED (duplicate within the cool-down).
  status     String
  error      String?
  /// Same key within the cool-down = not sent again (stops alert floods).
  dedupeKey  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([dedupeKey, createdAt])
}

model BlockedEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  note      String?
  createdAt DateTime @default(now())
}

model Category {
  id              String                 @id @default(cuid())
  slug            String                 @unique
  name            String
  /// Shown under the heading on the category page and used as its meta description.
  description     String?
  /// Wide banner on the category page (4:1, e.g. 1920 x 480).
  bannerUrl       String?
  /// Optional phone version of the banner (2:1, e.g. 1200 x 600). Falls back to bannerUrl.
  bannerMobileUrl String?
  /// Hidden categories disappear from the shop (navigation, home, category page).
  visible         Boolean                @default(true)
  /// Listed in the header menu (keep it to a handful).
  showInHeader    Boolean                @default(true)
  sortOrder       Int                    @default(0)
  products        Product[]
  /// Old slugs that redirect here (kept when the slug is changed).
  slugRedirects   CategorySlugRedirect[]
  discounts       Discount[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @default(now()) @updatedAt
}

model Product {
  id                String       @id @default(cuid())
  slug              String       @unique
  name              String
  shortDescription  String
  description       String
  brand             String
  platform          String
  region            String       @default("Global")
  priceCents        Int // USD cents: the main price, required
  /// Optional fixed LKR price (cents). When null, LKR is calculated from
  /// priceCents with the exchange rate + margin in StoreSettings.
  priceLkrCents     Int?
  /// ADMIN ONLY. What the store pays per key (cents, in costCurrency). Hidden
  /// from every query by default (global omit in lib/db.ts).
  costCents         Int?
  costCurrency      String       @default("USD")
  /// Per-product low stock level; null = the store default (StoreSettings).
  lowStockThreshold Int?
  /// Last stock alert level sent: null (fine), "LOW" or "OUT". Lets each drop
  /// alert once; restocking re-arms it.
  stockAlertState   String?
  imageUrl          String?
  categoryId        String
  category          Category     @relation(fields: [categoryId], references: [id])
  published         Boolean      @default(true)
  featured          Boolean      @default(false)
  licenseKeys       LicenseKey[]
  orderItems        OrderItem[]
  discounts         Discount[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([categoryId])
  @@index([published])
}

model LicenseKey {
  // The license key itself is encrypted at rest with AES-256-GCM (see lib/crypto.ts).
  id               String     @id @default(cuid())
  productId        String
  product          Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  secretCiphertext String
  secretIv         String
  secretAuthTag    String
  fingerprint      String     @unique // sha256 of the normalized plaintext, used to dedupe uploads
  status           KeyStatus  @default(AVAILABLE)
  orderItemId      String?
  orderItem        OrderItem? @relation(fields: [orderItemId], references: [id])
  reservedAt       DateTime?
  soldAt           DateTime?
  createdAt        DateTime   @default(now())

  @@index([productId, status])
  @@index([orderItemId])
}

model Order {
  id                    String      @id @default(cuid())
  orderNumber           String      @unique
  userId                String?
  user                  User?       @relation(fields: [userId], references: [id])
  email                 String
  status                OrderStatus @default(PENDING)
  subtotalCents         Int
  totalCents            Int
  /// ADMIN ONLY. Gateway fee estimated at checkout (order currency, cents).
  feeCents              Int?
  currency              String      @default("usd")
  stripeSessionId       String?     @unique
  stripePaymentIntentId String?
  refundNote            String?
  refundedAt            DateTime?
  items                 OrderItem[]
  createdAt             DateTime    @default(now())
  paidAt                DateTime?
  updatedAt             DateTime    @updatedAt

  @@index([userId])
  @@index([email])
}

model OrderItem {
  id              String       @id @default(cuid())
  orderId         String
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product      @relation(fields: [productId], references: [id])
  productName     String
  unitPriceCents  Int
  /// Price before any sale (order currency). Null on orders from before sales existed.
  listPriceCents  Int?
  /// Sale applied at checkout, if any (kept for order history and reports).
  discountPercent Float?
  discountName    String?
  /// ADMIN ONLY. Cost per key at checkout, converted to the order currency.
  /// Null when the product had no cost price set.
  unitCostCents   Int?
  quantity        Int
  licenseKeys     LicenseKey[]

  @@index([orderId])
}
