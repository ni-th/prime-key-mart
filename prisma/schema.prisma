// Keysby data model. See prisma/seed.ts for sample data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum KeyStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  FAILED
  EXPIRED
  REFUNDED
}

model User {
  id             String               @id @default(cuid())
  email          String               @unique
  name           String?
  passwordHash   String?
  role           Role                 @default(USER)
  suspended      Boolean              @default(false)
  suspendedAt    DateTime?
  suspensionNote String?
  // Two-factor auth (authenticator app). Required for ADMIN users.
  // totpSecret is a JSON-encoded EncryptedSecret (AES-256-GCM, see lib/crypto.ts).
  totpSecret     String?
  totpEnabled    Boolean              @default(false)
  totpLastStep   Int? // last accepted 30s time-step; blocks code replay
  orders         Order[]
  passwordResets PasswordResetToken[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

/// One-time "forgot password" link. Only a SHA-256 of the token is stored, so a
/// database leak can't be turned into working reset links.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

/// Store-wide settings editable in the admin panel. A single row, id "default".
model StoreSettings {
  id                String   @id @default("default")
  /// LKR per 1 USD (market rate). Null = fall back to PAYHERE_USD_TO_LKR_RATE.
  usdToLkrRate      Float?
  /// Added on top of the market rate for calculated LKR prices (e.g. 2.5 = +2.5%).
  lkrMarginPercent  Float    @default(0)
  /// Payment gateway (PayHere) fee as a percent of each payment, for profit reports.
  gatewayFeePercent Float    @default(0)
  updatedAt         DateTime @updatedAt
  updatedBy         String?
}

model BlockedEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  note      String?
  createdAt DateTime @default(now())
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  sortOrder Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id               String       @id @default(cuid())
  slug             String       @unique
  name             String
  shortDescription String
  description      String
  brand            String
  platform         String
  region           String       @default("Global")
  priceCents       Int // USD cents: the main price, required
  /// Optional fixed LKR price (cents). When null, LKR is calculated from
  /// priceCents with the exchange rate + margin in StoreSettings.
  priceLkrCents    Int?
  /// ADMIN ONLY. What the store pays per key (cents, in costCurrency). Hidden
  /// from every query by default (global omit in lib/db.ts).
  costCents        Int?
  costCurrency     String       @default("USD")
  imageUrl         String?
  categoryId       String
  category         Category     @relation(fields: [categoryId], references: [id])
  published        Boolean      @default(true)
  featured         Boolean      @default(false)
  licenseKeys      LicenseKey[]
  orderItems       OrderItem[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([categoryId])
  @@index([published])
}

model LicenseKey {
  // The license key itself is encrypted at rest with AES-256-GCM (see lib/crypto.ts).
  id               String     @id @default(cuid())
  productId        String
  product          Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  secretCiphertext String
  secretIv         String
  secretAuthTag    String
  fingerprint      String     @unique // sha256 of the normalized plaintext, used to dedupe uploads
  status           KeyStatus  @default(AVAILABLE)
  orderItemId      String?
  orderItem        OrderItem? @relation(fields: [orderItemId], references: [id])
  reservedAt       DateTime?
  soldAt           DateTime?
  createdAt        DateTime   @default(now())

  @@index([productId, status])
  @@index([orderItemId])
}

model Order {
  id                    String      @id @default(cuid())
  orderNumber           String      @unique
  userId                String?
  user                  User?       @relation(fields: [userId], references: [id])
  email                 String
  status                OrderStatus @default(PENDING)
  subtotalCents         Int
  totalCents            Int
  /// ADMIN ONLY. Gateway fee estimated at checkout (order currency, cents).
  feeCents              Int?
  currency              String      @default("usd")
  stripeSessionId       String?     @unique
  stripePaymentIntentId String?
  refundNote            String?
  refundedAt            DateTime?
  items                 OrderItem[]
  createdAt             DateTime    @default(now())
  paidAt                DateTime?
  updatedAt             DateTime    @updatedAt

  @@index([userId])
  @@index([email])
}

model OrderItem {
  id             String       @id @default(cuid())
  orderId        String
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  productName    String
  unitPriceCents Int
  /// ADMIN ONLY. Cost per key at checkout, converted to the order currency.
  /// Null when the product had no cost price set.
  unitCostCents  Int?
  quantity       Int
  licenseKeys    LicenseKey[]

  @@index([orderId])
}
